graph S {
  graph [layout=neato, fontname="Helvetica", overlap=false, splines=true, bgcolor="white"];
  node [shape=plain, fontname="Helvetica", fontsize=9];
  edge [color="#666666", penwidth=1.2];
  F [pos="0,0!", label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#c1121f"><font color="white"><b>dw.FactVentas</b></font></td></tr><tr><td align="left">PK IdDetalle (grano: línea)</td></tr><tr><td align="left">FK SK_Tiempo · SK_Hora</td></tr><tr><td align="left">FK SK_Producto · SK_Cliente</td></tr><tr><td align="left">FK SK_Empleado · SK_MetodoPago</td></tr><tr><td align="left">NroVenta (degenerada)</td></tr><tr><td align="left" bgcolor="#fde2e4">Cantidad · Importe · Costo · Margen</td></tr></table>>];
  T [pos="-3.6,2.2!", label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#1d3557"><font color="white"><b>DimTiempo</b></font></td></tr><tr><td align="left">PK SK_Tiempo (AAAAMMDD)</td></tr><tr><td align="left">Fecha · Anio · Trimestre · Mes</td></tr><tr><td align="left">NombreMes · NombreDia</td></tr><tr><td align="left">EsFinDeSemana · EsFeriado · Temporada</td></tr></table>>];
  H [pos="0,3.0!", label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#1d3557"><font color="white"><b>DimHora</b></font></td></tr><tr><td align="left">PK SK_Hora (0-23)</td></tr><tr><td align="left">Franja · Turno</td></tr></table>>];
  P [pos="3.6,2.2!", label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#1d3557"><font color="white"><b>DimProducto</b></font></td></tr><tr><td align="left">PK SK_Producto · IdProducto</td></tr><tr><td align="left">Producto · Categoria</td></tr><tr><td align="left">EsAlcoholico</td></tr><tr><td align="left">PrecioVenta · PrecioCompra</td></tr></table>>];
  C [pos="-3.6,-2.2!", label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#1d3557"><font color="white"><b>DimCliente</b></font></td></tr><tr><td align="left">PK SK_Cliente · IdCliente</td></tr><tr><td align="left">ClienteAnonimo (CLI-00025)</td></tr><tr><td align="left">TipoCliente</td></tr></table>>];
  E [pos="3.6,-2.2!", label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#1d3557"><font color="white"><b>DimEmpleado</b></font></td></tr><tr><td align="left">PK SK_Empleado · IdEmpleado</td></tr><tr><td align="left">Empleado · Cargo · Turno</td></tr></table>>];
  M [pos="0,-3.0!", label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#1d3557"><font color="white"><b>DimMetodoPago</b></font></td></tr><tr><td align="left">PK SK_MetodoPago · IdMetodoPago</td></tr><tr><td align="left">MetodoPago · EsDigital</td></tr></table>>];
  F -- T; F -- H; F -- P; F -- C; F -- E; F -- M;
}
